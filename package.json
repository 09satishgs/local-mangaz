{
  "name": "home-manga-db",
  "version": "1.0.0",
  "description": "Local manga search and downloader with rate-limited MangaDex integration",
  "main": "server/index.js",
  "scripts": {
    "server": "node --env-file=.env server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "start": "node --env-file=.env server/index.js"
  },
  "keywords": [
    "manga",
    "mangadex",
    "downloader"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0"
  }
}
